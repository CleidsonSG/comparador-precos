{
  "id": "./",
  "name": "Gôndola: comparador de preços",
  "short_name": "Gôndola",
  "description": "Importe suas notas fiscais (NFC-e) e compare preços entre compras e mercados.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./#inicio",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0e141b",
  "theme_color": "#ffc93c",
  "categories": ["shopping", "finance", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Ler QR do cupom", "short_name": "Ler QR", "url": "./#importar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Escanear produto", "short_name": "Escanear", "url": "./#escanear", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "nota", "accept": ["application/pdf", ".pdf", "text/xml", "application/xml", ".xml"] }]
    }
  }
}
